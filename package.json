{
  "name": "ticktick",
  "version": "2.0.0",
  "description": "TickTick 스타일 일정관리 macOS 앱",
  "main": "./out/main/index.js",
  "author": "supaicy",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --mac --config",
    "package:mas": "electron-vite build && electron-builder --mac mas --config",
    "package:bridge": "BRIDGE_BUILD=1 GREENDAY_RELEASE=1 electron-vite build && electron-builder --mac --arm64 --x64 --config electron-builder.bridge.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint src electron.vite.config.ts",
    "lint:fix": "biome check --write src electron.vite.config.ts",
    "format": "biome format --write src electron.vite.config.ts",
    "typecheck": "tsc --build",
    "verify": "npm run typecheck && npm run lint && npm test",
    "release": "bash scripts/release.sh",
    "mas:preflight": "bash scripts/mas-preflight.sh",
    "mas:build": "bash scripts/mas-preflight.sh && GREENDAY_RELEASE=1 electron-vite build && electron-builder --mac mas --universal",
    "mas:upload": "bash scripts/mas-upload.sh"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@atomic-editor/editor": "^0.6.2",
    "@biomejs/biome": "2.4.12",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron": "^40.8.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "i18next": "^26.3.6",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.577.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.11",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3",
    "vitest": "^4.1.1",
    "zustand": "^5.0.3"
  }
}
